---
const {
  level,
  xp,
  xpToNextLevel,
  streakDays,
  progressPercent
} = Astro.props;

const safeProgress = Math.min(100, Math.max(0, Number(progressPercent ?? 0)));
---
<div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
  <div class="flex items-start justify-between">
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-400">Dein Level</p>
      <p class="mt-1 text-2xl font-semibold text-slate-800">Level {level}</p>
    </div>
    <div class="rounded-xl bg-indigo-100 px-3 py-2 text-sm font-semibold text-indigo-700">
      {xp} XP
    </div>
  </div>

  <div class="mt-5">
    <div class="flex items-center justify-between text-sm text-slate-500">
      <span>Fortschritt</span>
      <span>
        {xp} / {xpToNextLevel} XP
      </span>
    </div>
    <div class="mt-2 h-3 w-full rounded-full bg-indigo-100">
      <div
        class="h-3 rounded-full bg-indigo-500 transition-all duration-300"
        style={`width: ${safeProgress}%`}
      ></div>
    </div>
  </div>

  <div class="mt-5 flex items-center justify-between text-sm text-slate-600">
    <span>Streak</span>
    <span class="font-medium">{streakDays} Tage</span>
  </div>
</div>
